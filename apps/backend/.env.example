# DB configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=talkie
DB_SYNC=true

# app configuration
NODE_ENV=development
APP_NAME=talkie
PORT=3000
# jwt configuration 
JWT_SECRET=

# google oauth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:8080/oauth

# frontend configuration
FRONTEND_END_URL=http://localhost:8080/


# email configuration
MAIL_FROM=


# Development Transporter (Mailtrap)
DEV_MAIL_HOST=sandbox.smtp.mailtrap.io
DEV_MAIL_PORT=587
DEV_MAIL_USER=
DEV_MAIL_PASS=

# Production Transporter (AWS SES / SendGrid)
PROD_MAIL_HOST=smtp.sendgrid.net
PROD_MAIL_PORT=587
PROD_MAIL_USER=apikey
PROD_MAIL_PASS=


# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Throttle configuration

THROTTLE_LIMIT=
THROTTLE_TTL=