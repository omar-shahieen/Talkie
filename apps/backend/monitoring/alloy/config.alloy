// Discover docker containers
discovery.docker "talkie" {
  host = "unix:///var/run/docker.sock"
}

// Stream stdout/stderr from backend container
loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.talkie.targets
  forward_to = [loki.process.parse_json.receiver]
  relabel_rules = [
    rule {
      source_labels = ["__meta_docker_container_name"]
      regex         = "/?(talkie-backend.*)"
      action        = "keep"
    },
  ]
}

// Pipeline: parse the structured JSON from stdout
loki.process "parse_json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level         = "level",
      correlationId = "correlationId",
      context       = "context",
    }
  }

  stage.labels {
    values = {
      level         = null,
      correlationId = null,
      context       = null,
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
