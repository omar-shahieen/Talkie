# Database  - attached resource, addressed by URL only
# Local: postgres://postgres:postgres@localhost:5432/talkie
# Managed: postgres://user:pass@host:5432/db?sslmode=require
# (URL-encode special characters in the password)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talkie
# Defaults to true outside production and false in production. Never enable in production.
DB_SYNC=true

# Postgres container credentials (used only by compose.yml to create the DB
# and to build the api DATABASE_URL inside the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talkie

# app configuration
NODE_ENV=development
APP_NAME=talkie
PORT=3000
# jwt configuration 
JWT_SECRET=

# google oauth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:8080/oauth

# frontend configuration
FRONTEND_END_URL=http://localhost:8080/
# Allowed browser origins (comma-separated) for HTTP + Socket.IO CORS in production.
# Falls back to FRONTEND_END_URL. Non-production allows any origin.
CORS_ORIGINS=http://localhost:8080

# Graceful shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000
# Time /health reports 503 before closing (defaults: 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=30000


# email configuration
MAIL_FROM=


# Mail configuration 
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=


# Redis - attached resource, addressed by URL only
# Local: redis://:password@localhost:6379
# Managed (TLS): rediss://default:pass@host:6379
REDIS_URL=redis://:password@localhost:6379

# Redis container password (used only by compose.yml to start the container
# and to build the api REDIS_URL inside the compose network)
REDIS_PASSWORD=password

# Cache Configuration
CACHE_TTL=5000

# Throttle configuration
THROTTLE_LIMIT=
THROTTLE_TTL=

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin


# Object Storage (Cloudflare R2)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=