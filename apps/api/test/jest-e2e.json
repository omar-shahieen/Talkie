{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@scure|@noble|otplib|nanoid)/)"
  ],
  "maxWorkers": 1,
  "testTimeout": 30000,
  "forceExit": true
}
