// Read log files
local.file_match "nestjs_logs" {
  path_targets = [{
    __path__ = "/var/log/app/*.log",
    app       = "talkie-backend",
  }]
}

loki.source.file "nestjs" {
  targets    = local.file_match.nestjs_logs.targets
  forward_to = [loki.process.parse_json.receiver]
}

// Pipeline: parse JSON and extract labels
loki.process "parse_json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level         = "level",
      correlationId = "correlationId",
      context       = "context",
    }
  }

  stage.labels {
    values = {
      level         = null,
      correlationId = null,
      context       = null,
    }
  }
}

// Ship to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}