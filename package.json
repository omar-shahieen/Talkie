{
  "name": "talkie-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev start:dev",
    "dev:backend": "nx start:dev @talkie/backend",
    "dev:frontend": "nx dev @talkie/frontend",
    "build": "nx run-many -t build",
    "build:backend": "nx build @talkie/backend",
    "build:frontend": "nx build @talkie/frontend",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint"
  },
  "devDependencies": {
    "nx": "^20.4.0"
  }
}
