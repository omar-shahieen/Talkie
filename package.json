{
  "name": "talkie-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev -t dev:worker",
    "dev:api": "nx run @talkie/api:dev",
    "dev:worker": "nx run @talkie/api:dev:worker",
    "dev:frontend": "nx run @talkie/frontend:dev",
    "build": "nx run-many -t build",
    "build:api": "nx run @talkie/api:build",
    "build:frontend": "nx run @talkie/frontend:build",
    "start:api": "nx run @talkie/api:start",
    "start:worker": "nx run @talkie/api:start:worker",
    "start:frontend": "nx run @talkie/frontend:serve",
    "test": "nx run-many -t test",
    "test:watch": "nx run @talkie/api:test:watch",
    "test:cov": "nx run @talkie/api:test:cov",
    "test:e2e": "nx run @talkie/api:test:e2e",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "typecheck": "nx run-many -t typecheck",
    "seed": "nx run @talkie/api:seed",
    "migration:generate": "npm --workspace=@talkie/api run migration:generate --",
    "migration:create": "npm --workspace=@talkie/api run migration:create --",
    "migration:run": "nx run @talkie/api:migration:run",
    "migration:revert": "nx run @talkie/api:migration:revert",
    "migration:status": "nx run @talkie/api:migration:status"
  },
  "devDependencies": {
    "nx": "24.0.2"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
